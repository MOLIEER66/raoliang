<?xml version="1.0" encoding="utf-8"?>
<!-- 颜色资源：仅服务 XML 层（图标/窗口底色），Compose 配色见 ui/theme/Color.kt -->
<resources>
    <!-- 自适应图标背景色 = 品牌色"回声青"，与 Color.kt 的 EchoPrimary 一致 -->
    <color name="ic_launcher_background">#00897B</color>

    <!-- 冷启动窗口底色，与 Compose 侧 EchoBackground 一致，避免深色模式启动闪白 -->
    <color name="window_background">#F7FAF9</color>
</resources>
